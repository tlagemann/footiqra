# Footiqra environment variables
# Copy to .env.local for local development. NEVER commit real values.
# In production these live in GitHub: Settings > Secrets and variables > Actions.

# --- Website build (public, inlined into HTML; never put secrets here) ---------
# Base URL for canonical links, sitemap and robots.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# "true" only on the final production domain. Otherwise robots.txt blocks indexing.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Data ingestion (npm run ingest) -------------------------------------------
# football-data.org API token (free registration). Sent as X-Auth-Token header only.
FOOTBALL_DATA_API_TOKEN=replace-with-your-token
# Client-side request budget. Free tier allows 10/min; keep a safety margin.
FOOTBALL_DATA_REQUESTS_PER_MINUTE=8
# Optional season override (start year, e.g. 2026). Defaults to the current season.
# FOOTIQRA_SEASON=2026
