# Footiqra environment variables
# Copy to .env.local for local development. NEVER commit real values.
# On SiteGround: Site Tools > Node.js > Deployment Options > Environment variables.

# --- Public (inlined into browser code, never put secrets here) ---------------
# Base URL for canonical links, sitemap and robots.txt (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Set to "true" only on the final production domain. Otherwise robots.txt blocks indexing.
NEXT_PUBLIC_ALLOW_INDEXING=false

# --- Server only ---------------------------------------------------------------
# PostgreSQL connection string (SiteGround Site Tools > Site > PostgreSQL).
DATABASE_URL=postgres://USER:PASSWORD@HOST:5432/DATABASE

# football-data.org API token (free registration, sent as X-Auth-Token header).
FOOTBALL_DATA_API_TOKEN=replace-with-your-token
# Client-side request budget. Free tier allows 10/min; keep a safety margin.
FOOTBALL_DATA_REQUESTS_PER_MINUTE=8

# Shared secret for on-demand page revalidation after an ingestion run (min. 32 chars).
REVALIDATE_SECRET=replace-with-a-long-random-string

# Build target: "server" (SiteGround Node.js Project, default) or "export" (static fallback).
FOOTIQRA_BUILD_TARGET=server
