# Footiqra: Apache settings for the static site on SiteGround.
# Deployed with the site (public/ is copied into out/).

# Our own 404 page instead of the host's default page
ErrorDocument 404 /page-not-found/

<IfModule mod_rewrite.c>
  RewriteEngine On

  # German predicted final tables moved from /prognose/ to /tabellenprognose/ (06.11.2026),
  # so they no longer compete with the matchday tips under /prognosen/ for the same searches.
  RewriteRule ^de/ligen/([^/]+)/prognose/?$ /de/ligen/$1/tabellenprognose/ [R=301,L]

  # German blog posts got German URL slugs (25.11.2026); old English slugs redirect.
  RewriteRule ^de/blog/barcelona-title-chances-what-went-wrong/?$ /de/blog/barcelona-meisterchancen-was-ist-passiert/ [R=301,L]
  RewriteRule ^de/blog/brighton-europes-7th-best-team/?$ /de/blog/brighton-siebtbestes-team-europas/ [R=301,L]
  RewriteRule ^de/blog/football-ratings-glossary/?$ /de/blog/glossar-elo-rating-ligastaerke/ [R=301,L]
  RewriteRule ^de/blog/home-advantage-in-football/?$ /de/blog/heimvorteil-im-fussball/ [R=301,L]
  RewriteRule ^de/blog/how-accurate-are-our-football-predictions/?$ /de/blog/wie-gut-sind-fussball-prognosen/ [R=301,L]
  RewriteRule ^de/blog/how-the-power-ranking-works/?$ /de/blog/so-funktioniert-das-power-ranking/ [R=301,L]
  RewriteRule ^de/blog/power-ranking-movers-2026-11-23/?$ /de/blog/power-ranking-gewinner-verlierer-2026-11-23/ [R=301,L]
  RewriteRule ^de/blog/strongest-league-in-europe/?$ /de/blog/staerkste-liga-europas/ [R=301,L]
  RewriteRule ^de/blog/the-7-leagues-we-rank/?$ /de/blog/die-7-ligen-im-power-ranking/ [R=301,L]
  RewriteRule ^de/blog/why-league-strength-matters/?$ /de/blog/warum-ligastaerke-zaehlt/ [R=301,L]

  # Folders without their own page (e.g. /teams/, /de/vereine/) answer 404 instead of 403.
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

# Legal pages moved to the German section when the site became bilingual.
RedirectMatch 301 ^/impressum/?$ /de/impressum/
RedirectMatch 301 ^/datenschutz/?$ /de/datenschutz/

<IfModule mod_headers.c>
  # Pages change with every data update. "no-cache" makes browsers revalidate
  # (cheap 304 responses) and keeps SiteGround's Dynamic Cache from storing stale
  # copies (SiteGround skips responses with no-cache; check x-proxy-cache header).
  <FilesMatch "\.(html|txt)$">
    Header unset Expires
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Sitemap and robots.txt: short cache. Note: SiteGround's NGINX direct delivery may
  # serve these files itself with its own expiry; search engines refetch them anyway.
  <FilesMatch "\.xml$">
    Header unset Expires
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Build assets have content hashes in their names and never change.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header unset Expires
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Crests are images only.
  <If "%{REQUEST_URI} =~ m#^/crests/#">
    Header set Cache-Control "public, max-age=604800"
    Header set Content-Security-Policy "default-src 'none'"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

