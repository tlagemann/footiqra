# Footiqra: Apache settings for the static site on SiteGround.
# Deployed with the site (public/ is copied into out/).

# Our own 404 page instead of the host's default page
ErrorDocument 404 /page-not-found/

# Folders without their own page (e.g. /teams/, /de/vereine/) answer 404 instead of 403.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteCond %{REQUEST_FILENAME}/index.html !-f
  RewriteRule ^ - [R=404,L]
</IfModule>

# Legal pages moved to the German section when the site became bilingual.
RedirectMatch 301 ^/impressum/?$ /de/impressum/
RedirectMatch 301 ^/datenschutz/?$ /de/datenschutz/

<IfModule mod_headers.c>
  # Pages change with every data update. "no-cache" makes browsers revalidate
  # (cheap 304 responses) and keeps SiteGround's Dynamic Cache from storing stale
  # copies (SiteGround skips responses with no-cache; check x-proxy-cache header).
  <FilesMatch "\.(html|txt)$">
    Header unset Expires
    Header set Cache-Control "no-cache"
  </FilesMatch>

  # Sitemap and robots.txt: short cache. Note: SiteGround's NGINX direct delivery may
  # serve these files itself with its own expiry; search engines refetch them anyway.
  <FilesMatch "\.xml$">
    Header unset Expires
    Header set Cache-Control "public, max-age=3600"
  </FilesMatch>

  # Build assets have content hashes in their names and never change.
  <If "%{REQUEST_URI} =~ m#^/_next/static/#">
    Header unset Expires
    Header set Cache-Control "public, max-age=31536000, immutable"
  </If>

  # Crests are images only.
  <If "%{REQUEST_URI} =~ m#^/crests/#">
    Header set Cache-Control "public, max-age=604800"
    Header set Content-Security-Policy "default-src 'none'"
  </If>

  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

